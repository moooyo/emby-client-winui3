    <Compile Include="../../src/EmbyClient.App/Services/AppDataPaths.cs" Link="Product/AppDataPaths.cs" />
    <Compile Include="../../src/EmbyClient.App/Services/SettingsJsonContext.cs" Link="Product/SettingsJsonContext.cs" />
    <Compile Include="../../src/EmbyClient.App/Services/ConnectionService.cs" Link="Product/ConnectionService.cs" />
    <Compile Include="../../src/EmbyClient.App/Services/ConnectionService.AccountTransactions.cs" Link="Product/ConnectionService.AccountTransactions.cs" />
    <ProjectReference Include="../../src/EmbyClient.Api/EmbyClient.Api.csproj" />
  </ItemGroup>
</Project>
