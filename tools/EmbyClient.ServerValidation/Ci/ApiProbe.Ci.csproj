<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EmbyClient.ServerValidation.ApiProbe</RootNamespace>
    <AssemblyName>ApiProbe.Ci</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ApiProbe/*.cs" Link="ApiProbe/%(Filename)%(Extension)" />
    <ProjectReference Include="../../../src/EmbyClient.Api/EmbyClient.Api.csproj" />
    <ProjectReference Include="../../../src/EmbyClient.Playback/EmbyClient.Playback.csproj" />
  </ItemGroup>
</Project>
