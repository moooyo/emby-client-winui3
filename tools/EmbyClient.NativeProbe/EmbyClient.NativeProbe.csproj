<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EmbyClient.NativeProbe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <ProjectReference Include="../../src/EmbyClient.Api/EmbyClient.Api.csproj" />
    <ProjectReference Include="../../src/EmbyClient.Playback/EmbyClient.Playback.csproj" />
    <Compile Include="../../src/EmbyClient.App/Playback/*.cs" Link="ProductPlayback/%(Filename)%(Extension)" />
    <Compile Include="../../src/EmbyClient.App/Services/NativePosterDecoder.cs" Link="ProductServices/NativePosterDecoder.cs" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
</Project>
