set(VCPKG_LIBRARY_LINKAGE dynamic)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_ENV_PASSTHROUGH EMBY_ASS_MSVC_VERSION EMBY_ASS_WINDOWS_SDK_VERSION)

