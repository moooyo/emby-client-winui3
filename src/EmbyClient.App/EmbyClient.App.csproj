<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EmbyClient.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <Version>0.1.0</Version>
    <LibraryObservation Condition="'$(LibraryObservation)' == ''">false</LibraryObservation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="WinUIEx" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\third-party\**\*"
             Link="licenses\third-party\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectReference Include="../EmbyClient.Api/EmbyClient.Api.csproj" />
    <ProjectReference Include="../EmbyClient.Playback/EmbyClient.Playback.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LibraryObservation)' == 'true'">
    <Compile Include="..\..\tools\EmbyClient.LibraryObservation\LibraryView.Observation.cs"
             Link="Observation\LibraryView.Observation.cs" />
  </ItemGroup>
</Project>
