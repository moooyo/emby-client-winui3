<ContentDialog
    x:Class="EmbyClient.App.Views.PlaybackQueueDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EmbyClient.App.Services"
    Title="Queue"
    CloseButtonText="Close"
    DefaultButton="Close">
    <ScrollViewer x:Name="ContentScroller" MaxHeight="480" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DialogContent" MaxWidth="480" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CountText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Queued by you. Plays before automatic episode continuation. Switching accounts clears this queue."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="2">
                <StackPanel x:Name="EmptyState" Spacing="8" Padding="16,28" MaxWidth="340"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE142;" FontSize="28" Margin="0,0,0,4"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Nothing queued yet" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Add a movie or episode from the library."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ListView x:Name="QueueList" SelectionMode="Single" IsItemClickEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
                          AutomationProperties.Name="Queued media" AutomationProperties.HelpText="Select an item to move or remove it. Press Delete to remove the selected item."
                          SelectionChanged="QueueSelectionChanged"
                          ContainerContentChanging="QueueContainerContentChanging" KeyDown="QueueKeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="68" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:PlaybackQueueEntry">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OrderText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="NextText" Text="Next in queue" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               AutomationProperties.AccessibilityView="Raw" Visibility="Collapsed" />
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <CommandBar Grid.Row="3" x:Name="QueueActions" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                        Background="Transparent" AutomationProperties.Name="Queue actions">
                <AppBarButton x:Name="MoveUpButton" Label="Move up" AutomationProperties.Name="Move up"
                              AutomationProperties.HelpText="Move the selected queue item earlier."
                              Click="MoveUpClicked" IsEnabled="False">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="MoveDownButton" Label="Move down" AutomationProperties.Name="Move down"
                              AutomationProperties.HelpText="Move the selected queue item later."
                              Click="MoveDownClicked" IsEnabled="False">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RemoveButton" Label="Remove" Icon="Remove" AutomationProperties.Name="Remove"
                              AutomationProperties.HelpText="Remove the selected item from the queue. The media file is kept."
                              Click="RemoveClicked" IsEnabled="False" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ClearButton" Label="Clear queue" Icon="Clear" AutomationProperties.Name="Clear queue"
                                  AutomationProperties.HelpText="Remove all queued items. The media files are kept."
                                  Click="ClearClicked" IsEnabled="False" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
    </ScrollViewer>
</ContentDialog>
