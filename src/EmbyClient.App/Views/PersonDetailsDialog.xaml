<ContentDialog
    x:Class="EmbyClient.App.Views.PersonDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels"
    xmlns:views="using:EmbyClient.App.Views"
    CloseButtonText="Back to details" DefaultButton="Close">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">760</x:Double></ContentDialog.Resources>
    <ScrollViewer x:Name="ContentScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DialogContent" Spacing="24" MaxWidth="680">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <views:PersonArtwork Item="{x:Bind ViewModel.Portrait, Mode=OneWay}" Width="80" Height="80"
                                     VerticalAlignment="Top" Loaded="Artwork_Loaded" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SourceLabel}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Person.Name}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.Person.Role}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <StackPanel Spacing="8">
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <ProgressBar Height="2" IsIndeterminate="{x:Bind ViewModel.IsLoadingBiography, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.BiographyLoadingVisibility, Mode=OneWay}" AutomationProperties.Name="Loading biography" />
                <TextBlock Text="{x:Bind ViewModel.Biography, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.BiographyErrorVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.BiographyError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Retry biography" Click="RetryBiography_Click" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="In your library" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Movies, series, and videos available to this account." FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <GridView x:Name="WorksGrid" ItemsSource="{x:Bind ViewModel.Works}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Work_ItemClick" ContainerContentChanging="Work_ContainerContentChanging" Loaded="WorksGrid_Loaded" MaxHeight="432"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="This person's works in your library">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="140" ItemHeight="272" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaCardViewModel">
                            <StackPanel Spacing="6">
                                <views:PersonArtwork Item="{x:Bind}" IsPerson="False" Width="120" Height="180" HorizontalAlignment="Left" Loaded="Artwork_Loaded" />
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind CardSubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoadingWorks, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.WorksLoadingVisibility, Mode=OneWay}" AutomationProperties.Name="Loading library works" />
                <TextBlock Text="No movies, series, or videos for this person are available in your library."
                           Visibility="{x:Bind ViewModel.EmptyWorksVisibility, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WorksErrorVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.WorksError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Retry library works" Click="LoadMore_Click" />
                </StackPanel>
                <Button Content="Load more" Click="LoadMore_Click" IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
