<UserControl
    x:Class="EmbyClient.App.Views.PersonArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
    <Grid>
        <PersonPicture x:Name="Portrait" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False" />
        <Border x:Name="PosterFrame" Visibility="Collapsed" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <FontIcon Glyph="&#xE714;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Image x:Name="Poster" Stretch="UniformToFill" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
