<UserControl
    x:Class="EmbyClient.App.Views.CastSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels"
    xmlns:views="using:EmbyClient.App.Views">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="CastRowPanel"><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CastGridPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="140" ItemHeight="176" Loaded="CastGridPanel_Loaded" Unloaded="CastGridPanel_Unloaded" /></ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Cast and crew" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
            <Button x:Name="ExpandButton" Grid.Column="1" Click="Expand_Click" Visibility="Collapsed" Style="{ThemeResource SubtleButtonStyle}" />
        </Grid>
        <TextBlock x:Name="EmptyText" Text="No cast or crew information has been provided by the server."
                   TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
        <GridView x:Name="PeopleGrid" ItemsSource="{x:Bind VisiblePeople}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="People_ItemClick"
                  ContainerContentChanging="People_ContainerContentChanging" Loaded="PeopleGrid_Loaded" SizeChanged="PeopleGrid_SizeChanged"
                  ItemsPanel="{StaticResource CastRowPanel}"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Cast and crew">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Width" Value="132" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonCardViewModel">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <views:PersonArtwork Item="{x:Bind Media}" Width="72" Height="72" HorizontalAlignment="Center" Loaded="Artwork_Loaded" />
                        <TextBlock Text="{x:Bind Name}" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Role}" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </StackPanel>
</UserControl>
