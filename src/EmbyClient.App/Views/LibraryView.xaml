<UserControl
    x:Class="EmbyClient.App.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels"
    xmlns:views="using:EmbyClient.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource DetailSecondaryTextBrush}" />
                    </Style>
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <LinearGradientBrush x:Key="LibraryTileOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#20000000" Offset="0" /><GradientStop Color="#E0000000" Offset="1" />
                    </LinearGradientBrush>
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource DetailSecondaryTextBrush}" />
                    </Style>
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <LinearGradientBrush x:Key="LibraryTileOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#20000000" Offset="0" /><GradientStop Color="#E0000000" Offset="1" />
                    </LinearGradientBrush>
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock" />
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <SolidColorBrush x:Key="LibraryTileOverlayBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource SystemColorButtonTextColor}" />
                        <Setter Property="HighContrastAdjustment" Value="None" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="FontIcon">
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>
            <Style x:Key="MediaContainerStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,12,16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="ShelfContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource MediaContainerStyle}">
                <Setter Property="Margin" Value="0,0,12,4" />
            </Style>
            <Style x:Key="EpisodeRowContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource ShelfContainerStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource DetailCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DetailCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <ItemsPanelTemplate x:Key="DetailVerticalPanelTemplate">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="DetailHorizontalPanelTemplate">
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
            <Style x:Key="IconActionStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <DataTemplate x:Key="MediaCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="156" RowSpacing="5" ToolTipService.ToolTip="{x:Bind SceneIdentity, Mode=OneWay}"
                      Loaded="MediaPosterCard_Loaded" SizeChanged="MediaPosterCard_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="234" /><RowDefinition Height="Auto" MinHeight="40" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border Background="{ThemeResource DetailCardBackgroundBrush}" CornerRadius="8">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind UnplayedCountVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind UnplayedCountLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind CardSubtitle, Mode=OneWay}" FontSize="12"
                               Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="272" RowSpacing="5" ToolTipService.ToolTip="{x:Bind SceneIdentity, Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="153" /><RowDefinition Height="Auto" MinHeight="20" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border Background="{ThemeResource DetailCardBackgroundBrush}" CornerRadius="8">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill"
                                   Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind CardSubtitle, Mode=OneWay}" FontSize="12"
                               Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LibraryCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="220" Height="64" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" Loaded="LibraryTile_Loaded">
                    <Border CornerRadius="6" Background="{ThemeResource DetailCardBackgroundBrush}"
                            BorderBrush="{ThemeResource DetailCardStrokeBrush}" BorderThickness="1" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontSize="22" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EpisodeRowTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid MinHeight="96" Padding="8" ColumnSpacing="16" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{x:Bind SceneIdentity, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                    <Border Height="63" CornerRadius="4" Background="{ThemeResource DetailCardBackgroundBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="24" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="3" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}" IsTabStop="False"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind EpisodeTitle, Mode=OneWay}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind EpisodeMetadata, Mode=OneWay}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind EpisodeSummary, Mode=OneWay}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource DetailSecondaryTextBrush}"
                                   TextWrapping="Wrap" Visibility="{x:Bind StateVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EpisodeCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="272" RowSpacing="6" ToolTipService.ToolTip="{x:Bind SceneIdentity, Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="153" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource DetailCardBackgroundBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill"
                                   Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind EpisodeTitle, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind EpisodeTitle, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind EpisodeMetadata, Mode=OneWay}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind EpisodeMetadata, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="{x:Bind EpisodeSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" Style="{ThemeResource MediaCaptionTextStyle}"
                               ToolTipService.ToolTip="{x:Bind EpisodeSummary, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PersonCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="128" RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="168" /><RowDefinition Height="Auto" MinHeight="20" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource DetailCardBackgroundBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="36" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind PersonRole}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind PersonRole}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="HomeShelfTemplate" x:DataType="vm:MediaShelfViewModel">
                <Grid Tag="{x:Bind}" RowSpacing="10" Margin="0,0,0,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="4,0,16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTipService.ToolTip="{x:Bind Title}" />
                        <HyperlinkButton Grid.Column="1" Tag="{x:Bind}" Content="See all" Click="ShelfSeeAll_Click"
                                         AutomationProperties.Name="{x:Bind SeeAllLabel}" />
                    </Grid>
                    <GridView Grid.Row="1" Tag="{x:Bind}" ItemsSource="{x:Bind Items}" Loaded="HomeShelf_Loaded"
                              ItemTemplate="{StaticResource MediaCardTemplate}" ItemContainerStyle="{StaticResource ShelfContainerStyle}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{x:Bind Title}">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <NavigationView x:Name="LibraryNavigation" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    OpenPaneLength="208" CompactPaneLength="48" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1008"
                    AlwaysShowHeader="False" SelectionChanged="LibraryNavigation_SelectionChanged"
                    BackRequested="LibraryNavigation_BackRequested" DisplayModeChanged="NavigationDisplayModeChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="SearchNavigationItem" Content="Search" Tag="search" Icon="Find" ToolTipService.ToolTip="Search (Ctrl+F)" />
            <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home" Icon="Home" />
            <NavigationViewItem x:Name="FavoritesNavigationItem" Content="Favorites" Tag="favorites" Icon="Favorite" />
            <NavigationViewItemSeparator /><NavigationViewItemHeader Content="Media libraries" />
        </NavigationView.MenuItems>
        <Grid Background="{ThemeResource DetailContentBackgroundBrush}">
            <Grid.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DetailControlHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DetailControlBackgroundBrush" />
                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="DetailControlHoverBrush" />
                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="DetailControlBackgroundBrush" />
                <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="DetailControlHoverBrush" />
                <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="DetailControlBackgroundBrush" />
            </Grid.Resources>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="32,20,28,12" Visibility="{x:Bind ViewModel.HeaderVisibility, Mode=OneWay}" RowSpacing="4" ColumnSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <Button x:Name="PageOptionsButton" Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" Padding="8"
                        VerticalAlignment="Center" AutomationProperties.Name="Page options" ToolTipService.ToolTip="Page options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Refresh" KeyboardAcceleratorTextOverride="Ctrl+R" Click="Refresh_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" MinHeight="20" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                           Foreground="{ThemeResource DetailSecondaryTextBrush}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="28,0">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Severity="Error" Title="Unable to load media"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="True">
                    <InfoBar.ActionButton><Button Content="Retry" Click="Refresh_Click" /></InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <ScrollViewer x:Name="HomeScroller" Grid.Row="2" Visibility="{x:Bind ViewModel.HomeVisibility, Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,12,12,24">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HomeRows}" ItemTemplate="{StaticResource HomeShelfTemplate}" />
                    <TextBlock Text="My media" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,16" AutomationProperties.HeadingLevel="Level2"
                               Visibility="{x:Bind ViewModel.HomeLibrariesVisibility, Mode=OneWay}" />
                    <GridView x:Name="MyMediaGrid" ItemsSource="{x:Bind ViewModel.Libraries}" ItemTemplate="{StaticResource LibraryCardTemplate}"
                              ItemContainerStyle="{StaticResource ShelfContainerStyle}" MinHeight="84" Margin="0,0,0,24"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="LibraryCard_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="My media" Visibility="{x:Bind ViewModel.HomeLibrariesVisibility, Mode=OneWay}">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="24,48" MaxWidth="400" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="28,8,16,20" RowSpacing="16" Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" MaxWidth="640" HorizontalAlignment="Stretch" PlaceholderText="Search movies, shows, and episodes" QueryIcon="Find" Visibility="Collapsed"
                                AutomationProperties.Name="Search your library" AutomationProperties.HelpText="Type a title and press Enter. Ctrl+F opens search."
                                TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
                <Grid Grid.Row="1" Margin="4,0,12,0" Visibility="{x:Bind ViewModel.BrowseOptionsVisibility, Mode=OneWay}" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SortBox" Header="Sort by" SelectedIndex="0" MinWidth="144" SelectionChanged="BrowseOptions_Changed" AutomationProperties.Name="Sort media by">
                        <ComboBoxItem Content="Title" Tag="SortName" /><ComboBoxItem Content="Year" Tag="ProductionYear" /><ComboBoxItem Content="Date added" Tag="DateCreated" />
                    </ComboBox>
                    <ToggleButton x:Name="DescendingButton" Grid.Column="1" Click="BrowseDirection_Click" Width="36" Height="34" VerticalAlignment="Bottom"
                                  AutomationProperties.Name="Ascending. Activate to sort descending." ToolTipService.ToolTip="Ascending. Click to sort descending.">
                        <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74A;" FontSize="14" />
                    </ToggleButton>
                    <ComboBox x:Name="WatchStatusSelector" Grid.Column="2" Header="Watch status" SelectedIndex="0" MinWidth="156" Margin="8,0,0,0"
                              SelectionChanged="BrowseOptions_Changed" AutomationProperties.Name="Watch status filter">
                        <ComboBoxItem Content="All items" />
                        <ComboBoxItem Content="Unplayed" />
                        <ComboBoxItem Content="Played" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2">
                    <GridView x:Name="MediaGrid" Padding="0" ItemsSource="{x:Bind ViewModel.Items}" ItemTemplate="{StaticResource MediaCardTemplate}"
                              ItemContainerStyle="{StaticResource MediaContainerStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging" Loaded="MediaGrid_Loaded" Unloaded="MediaGrid_Unloaded"
                              SizeChanged="CollectionViewport_SizeChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Media items">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                        <GridView.Footer>
                            <TextBlock Text="Loading more media…" Margin="0,16" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource DetailSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"
                                       Visibility="{x:Bind ViewModel.MoreLoadingVisibility, Mode=OneWay}" />
                        </GridView.Footer>
                    </GridView>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="16" Margin="24" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="Clear watch filter" Click="ClearBrowseFilterClicked" HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.FilterEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="DetailScroller" Grid.Row="2" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,0,32">
                    <Button x:Name="DetailBackButton" Margin="28,12,28,4" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="DetailBackClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock x:Name="DetailBreadcrumb" Text="Back to library" FontSize="12" /></StackPanel>
                    </Button>
                    <Grid x:Name="DetailHero" SizeChanged="DetailHero_SizeChanged">
                        <Grid x:Name="DetailLayout" Margin="32,12,32,24" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DetailPosterColumn" Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="DetailPosterFrame" Width="160" Height="240" CornerRadius="8"
                                    Background="{ThemeResource DetailCardBackgroundBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid>
                                    <FontIcon Glyph="&#xE714;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="DetailPoster" Tag="{x:Bind ViewModel.Detail, Mode=OneWay}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DetailInformation" Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                                <Button Content="{x:Bind ViewModel.Detail.ParentSeriesLabel, Mode=OneWay}" Click="ParentSeries_Click"
                                        Visibility="{x:Bind ViewModel.Detail.ParentSeriesVisibility, Mode=OneWay}" HorizontalAlignment="Left"
                                        Style="{ThemeResource SubtleButtonStyle}" Padding="0,4" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind ViewModel.Detail.Title, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Metadata, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Genres, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Detail.GenresVisibility, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PrimaryPlayButton" Style="{ThemeResource AccentButtonStyle}" Click="PrimaryPlay_Click" MinHeight="40"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryPlayHint, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanUseSeasonActions, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.PrimaryPlayLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton IsChecked="{x:Bind ViewModel.Detail.IsFavorite, Mode=OneWay}" Click="Favorite_Click" Width="40" Height="40" Background="{ThemeResource DetailControlBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}"
                                                  ToolTipService.ToolTip="{x:Bind ViewModel.Detail.FavoriteLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Detail.FavoriteLabel, Mode=OneWay}"
                                                  IsEnabled="{x:Bind ViewModel.CanEditDetails, Mode=OneWay}">
                                        <FontIcon Glyph="&#xEB51;" FontSize="18" />
                                    </ToggleButton>
                                    <Button x:Name="DetailMoreButton" Width="40" Height="40" Background="{ThemeResource DetailControlBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}" AutomationProperties.Name="More item actions" ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" FontSize="18" />
                                        <Button.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="Play from beginning" Click="Play_Click" Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUseSeasonActions, Mode=OneWay}" />
                                            <MenuFlyoutItem Text="Add to queue" Click="Queue_Click" Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUseSeasonActions, Mode=OneWay}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.Detail.PlayedLabel, Mode=OneWay}" Click="MarkPlayedMenuClicked" IsEnabled="{x:Bind ViewModel.CanEditDetails, Mode=OneWay}" />
                                        </MenuFlyout></Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PlaybackUnavailableMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}"
                                           Visibility="{x:Bind ViewModel.PlaybackUnavailableVisibility, Mode=OneWay}" />
                                <TextBlock x:Name="OverviewText" MaxWidth="720" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Detail.Overview, Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                                <ToggleButton x:Name="OverviewToggle" Content="Read more" Click="OverviewToggleClicked" Visibility="Collapsed" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Margin="28,8,12,24" RowSpacing="16" Visibility="{x:Bind ViewModel.DetailChildrenVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="120" /></Grid.RowDefinitions>
                        <Grid Margin="4,0,16,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.DetailChildrenTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level2" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DetailChildrenTitle, Mode=OneWay}" />
                            <ComboBox x:Name="SeasonBox" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Seasons}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=OneWay}" MinWidth="144" MaxWidth="240"
                                      Background="{ThemeResource DetailControlBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}"
                                      IsEnabled="{x:Bind ViewModel.CanSelectSeason, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.SeasonSelectorVisibility, Mode=OneWay}"
                                      SelectionChanged="SeasonBox_SelectionChanged" AutomationProperties.Name="Choose a season" />
                            <ToggleButton x:Name="EpisodeLayoutButton" Grid.Column="2" Width="36" Height="36" IsChecked="True" Click="EpisodeLayoutClicked" ToolTipService.ToolTip="Episode list view" AutomationProperties.Name="Episode list view"
                                          Background="{ThemeResource DetailControlBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}">
                                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                            </ToggleButton>
                        </Grid>
                        <Border Grid.Row="1" Margin="4,0,16,0" Padding="12" CornerRadius="6" Background="{ThemeResource DetailCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DetailCardStrokeBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.SeasonSwitchVisibility, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ProgressRing Width="20" Height="20" IsActive="True" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeasonSwitchMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <Button Grid.Column="2" Content="Cancel" Click="CancelSeasonSwitch_Click" />
                            </Grid>
                        </Border>
                        <GridView x:Name="DetailItemsGrid" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}" MinHeight="120"
                                  IsEnabled="{x:Bind ViewModel.CanUseSeasonActions, Mode=OneWay}"
                                  ItemTemplate="{StaticResource EpisodeRowTemplate}" ItemContainerStyle="{StaticResource EpisodeRowContainerStyle}"
                                  ItemsPanel="{StaticResource DetailVerticalPanelTemplate}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick" ContainerContentChanging="MediaGrid_ContainerContentChanging"
                                  Loaded="DetailItemsGrid_Loaded" Unloaded="DetailItemsGrid_Unloaded" SizeChanged="CollectionViewport_SizeChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Seasons and episodes"
                                  Visibility="{x:Bind ViewModel.DetailItemsVisibility, Mode=OneWay}">
                            <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                        </GridView>
                        <ProgressRing Grid.Row="2" Width="32" Height="32" Margin="0,40" IsActive="{x:Bind ViewModel.IsDetailChildrenLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.DetailChildrenLoadingVisibility, Mode=OneWay}" AutomationProperties.Name="Loading episodes" />
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Margin="4,16"
                                   Foreground="{ThemeResource DetailSecondaryTextBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.DetailEmptyVisibility, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Margin="32,0,32,24" Spacing="12" Visibility="{x:Bind ViewModel.NextEpisodeVisibility, Mode=OneWay}">
                        <TextBlock Text="Next episode" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                        <Button Click="NextEpisode_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12"
                                Background="{ThemeResource DetailCardBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}"
                                AutomationProperties.Name="{x:Bind ViewModel.NextEpisode.SceneIdentity, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Height="72" CornerRadius="4" Background="{ThemeResource DetailChipBackgroundBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE714;" FontSize="24" IsTextScaleFactorEnabled="False" />
                                        <Image Tag="{x:Bind ViewModel.NextEpisode, Mode=OneWay}" AutomationProperties.AutomationId="LandscapeArtwork"
                                               Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.NextEpisode.DetailIdentity, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.NextEpisode.Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.NextEpisode.RuntimeLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" IsTextScaleFactorEnabled="False" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <views:CastSection x:Name="DetailCast" Margin="32,0,32,0" Item="{x:Bind ViewModel.Detail, Mode=OneWay}" Loaded="Cast_Loaded" PersonInvoked="Cast_PersonInvoked" />
                    <views:MediaInformationSection x:Name="MediaInformation" Margin="32,24,32,0" Item="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.Detail.MediaInformation.Visibility, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="28"
                        Visibility="{x:Bind ViewModel.InitialFailureVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE783;" FontSize="32" IsTextScaleFactorEnabled="False" />
                <TextBlock Text="Unable to load media" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                <Button Content="Retry" Click="Refresh_Click" HorizontalAlignment="Center" />
            </StackPanel>
            <ContentControl x:Name="PersonPageHost" Grid.Row="2" Visibility="{x:Bind ViewModel.PersonVisibility, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ProgressBar Grid.Row="2" Height="2" VerticalAlignment="Top" Margin="28,0" IsHitTestVisible="False"
                         IsIndeterminate="{x:Bind ViewModel.IsBackgroundLoading, Mode=OneWay}" AutomationProperties.Name="Refreshing media"
                         Visibility="{x:Bind ViewModel.BackgroundLoadingVisibility, Mode=OneWay}" />
            <ProgressBar Grid.Row="2" Height="2" VerticalAlignment="Top" Margin="28,0" IsHitTestVisible="False"
                         IsIndeterminate="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" AutomationProperties.Name="Loading more media"
                         Visibility="{x:Bind ViewModel.MoreLoadingVisibility, Mode=OneWay}" />
            <StackPanel Grid.Row="2" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.InitialLoadingVisibility, Mode=OneWay}">
                <ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" AutomationProperties.Name="Loading media" />
                <TextBlock Text="Loading media…" FontSize="12" Foreground="{ThemeResource DetailSecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </NavigationView>
</UserControl>
