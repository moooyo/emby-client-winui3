<UserControl
    x:Class="EmbyClient.App.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DetailSurfaceColor">#FAFAFA</Color>
                    <Color x:Key="DetailVeilColor">#E6FAFAFA</Color>
                    <Color x:Key="DetailFadeColor">#80FAFAFA</Color>
                    <SolidColorBrush x:Key="DetailAccessibilityOverlayBrush" Color="Transparent" />
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <LinearGradientBrush x:Key="LibraryTileOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#20000000" Offset="0" /><GradientStop Color="#E0000000" Offset="1" />
                    </LinearGradientBrush>
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DetailSurfaceColor">#202020</Color>
                    <Color x:Key="DetailVeilColor">#ED202020</Color>
                    <Color x:Key="DetailFadeColor">#80202020</Color>
                    <SolidColorBrush x:Key="DetailAccessibilityOverlayBrush" Color="Transparent" />
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <LinearGradientBrush x:Key="LibraryTileOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#20000000" Offset="0" /><GradientStop Color="#E0000000" Offset="1" />
                    </LinearGradientBrush>
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="DetailSurfaceColor">#000000</Color>
                    <Color x:Key="DetailVeilColor">#000000</Color>
                    <Color x:Key="DetailFadeColor">#000000</Color>
                    <SolidColorBrush x:Key="DetailAccessibilityOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <Style x:Key="MediaCaptionTextStyle" TargetType="TextBlock" />
                    <Style x:Key="MediaPlaceholderIconStyle" TargetType="FontIcon">
                        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                    </Style>
                    <SolidColorBrush x:Key="LibraryTileOverlayBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <Style x:Key="LibraryTileTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource SystemColorButtonTextColor}" />
                        <Setter Property="HighContrastAdjustment" Value="None" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="FontIcon">
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>
            <Style x:Key="MediaContainerStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,12,16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="ShelfContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource MediaContainerStyle}">
                <Setter Property="Margin" Value="0,0,12,4" />
            </Style>
            <Style x:Key="IconActionStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <DataTemplate x:Key="MediaCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="156" RowSpacing="5" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                      Loaded="MediaPosterCard_Loaded" SizeChanged="MediaPosterCard_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="234" /><RowDefinition Height="Auto" MinHeight="20" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind UnplayedCountVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind UnplayedCountLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind CardSubtitle, Mode=OneWay}" FontSize="12"
                               Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="272" RowSpacing="5" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="153" /><RowDefinition Height="Auto" MinHeight="20" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill"
                                   Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind CardSubtitle, Mode=OneWay}" FontSize="12"
                               Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LibraryCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="220" Height="124" ToolTipService.ToolTip="{x:Bind Title}" Loaded="LibraryTile_Loaded">
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8F1;" FontSize="36" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="20" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill"
                                   Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <Border Background="{ThemeResource LibraryTileOverlayBrush}" />
                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" Style="{ThemeResource LibraryTileTitleStyle}"
                                       VerticalAlignment="Bottom" Margin="16" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EpisodeCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="272" RowSpacing="6" ToolTipService.ToolTip="{x:Bind Title}">
                    <Grid.RowDefinitions><RowDefinition Height="153" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="32" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" AutomationProperties.AutomationId="LandscapeArtwork" Stretch="UniformToFill"
                                   Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom"
                                         AutomationProperties.Name="{x:Bind ResumeLabel, Mode=OneWay}"
                                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsTabStop="False" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind EpisodeTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind EpisodeTitle}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind EpisodeMetadata}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind EpisodeMetadata}" />
                    <TextBlock Grid.Row="3" Text="{x:Bind EpisodeSummary}" FontSize="12" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" Style="{ThemeResource MediaCaptionTextStyle}"
                               ToolTipService.ToolTip="{x:Bind EpisodeSummary}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PersonCardTemplate" x:DataType="vm:MediaCardViewModel">
                <Grid Width="128" RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="168" /><RowDefinition Height="Auto" MinHeight="20" /><RowDefinition Height="Auto" MinHeight="18" /></Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="36" Style="{ThemeResource MediaPlaceholderIconStyle}" />
                            <Image Tag="{x:Bind}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind PersonRole}" FontSize="12" Style="{ThemeResource MediaCaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind PersonRole}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="HomeShelfTemplate" x:DataType="vm:MediaShelfViewModel">
                <Grid Tag="{x:Bind}" RowSpacing="12" Margin="0,0,0,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="4,0,16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTipService.ToolTip="{x:Bind Title}" />
                        <HyperlinkButton Grid.Column="1" Tag="{x:Bind}" Content="See all" Click="ShelfSeeAll_Click"
                                         AutomationProperties.Name="{x:Bind SeeAllLabel}" />
                    </Grid>
                    <GridView Grid.Row="1" Tag="{x:Bind}" ItemsSource="{x:Bind Items}" Loaded="HomeShelf_Loaded"
                              ItemTemplate="{StaticResource MediaCardTemplate}" ItemContainerStyle="{StaticResource ShelfContainerStyle}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{x:Bind Title}">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <NavigationView x:Name="LibraryNavigation" IsSettingsVisible="False" IsBackButtonVisible="Visible"
                    IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" PaneTitle="Emby"
                    OpenPaneLength="232" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1100"
                    AlwaysShowHeader="False" SelectionChanged="LibraryNavigation_SelectionChanged"
                    BackRequested="LibraryNavigation_BackRequested">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home" Icon="Home" />
            <NavigationViewItem x:Name="FavoritesNavigationItem" Content="Favorites" Tag="favorites" Icon="Favorite" />
            <NavigationViewItemSeparator /><NavigationViewItemHeader Content="Media libraries" />
        </NavigationView.MenuItems>
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="28,12,28,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid MaxWidth="400" HorizontalAlignment="Left" MinWidth="200">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search your media" QueryIcon="Find"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Search your media"
                                    TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
                </Grid>
                <Button Grid.Column="1" Click="Refresh_Click" Style="{StaticResource IconActionStyle}" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh library">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="32,12,32,4" Visibility="{x:Bind ViewModel.HeaderVisibility, Mode=OneWay}" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock Grid.Row="1" MinHeight="20" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <StackPanel Grid.Row="2" Margin="28,0" Spacing="8">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Severity="Error" Title="Unable to load media"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="True">
                    <InfoBar.ActionButton><Button Content="Retry" Click="Refresh_Click" /></InfoBar.ActionButton>
                </InfoBar>
                <Grid Height="3">
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Height="3"
                                 AutomationProperties.Name="Loading media" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <ScrollViewer x:Name="HomeScroller" Grid.Row="3" Visibility="{x:Bind ViewModel.HomeVisibility, Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,12,12,24">
                    <TextBlock Text="My media" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,16" AutomationProperties.HeadingLevel="Level2"
                               Visibility="{x:Bind ViewModel.HomeLibrariesVisibility, Mode=OneWay}" />
                    <GridView x:Name="MyMediaGrid" ItemsSource="{x:Bind ViewModel.Libraries}" ItemTemplate="{StaticResource LibraryCardTemplate}"
                              ItemContainerStyle="{StaticResource ShelfContainerStyle}" MinHeight="152" Margin="0,0,0,24"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="LibraryCard_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="My media" Visibility="{x:Bind ViewModel.HomeLibrariesVisibility, Mode=OneWay}">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    </GridView>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HomeRows}" ItemTemplate="{StaticResource HomeShelfTemplate}" />
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="24,48" MaxWidth="400" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="28,8,16,20" RowSpacing="16" Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="4,0,12,0" Visibility="{x:Bind ViewModel.BrowseOptionsVisibility, Mode=OneWay}" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SortBox" SelectedIndex="0" MinWidth="144" SelectionChanged="BrowseOptions_Changed" AutomationProperties.Name="Sort media by">
                        <ComboBoxItem Content="Title" Tag="SortName" /><ComboBoxItem Content="Year" Tag="ProductionYear" /><ComboBoxItem Content="Date added" Tag="DateCreated" />
                    </ComboBox>
                    <ToggleButton x:Name="DescendingButton" Grid.Column="1" Click="BrowseDirection_Click" Width="36" Height="34"
                                  AutomationProperties.Name="Ascending. Activate to sort descending." ToolTipService.ToolTip="Ascending. Click to sort descending.">
                        <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74A;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnplayedFilter" Grid.Column="3" Content="Unplayed only" Click="BrowseDirection_Click"
                                  VerticalAlignment="Center" AutomationProperties.Name="Show unplayed items only"
                                  ToolTipService.ToolTip="Show only items you have not watched" />
                </Grid>
                <Grid Grid.Row="1">
                    <GridView x:Name="MediaGrid" Padding="0" ItemsSource="{x:Bind ViewModel.Items}" ItemTemplate="{StaticResource MediaCardTemplate}"
                              ItemContainerStyle="{StaticResource MediaContainerStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick"
                              ContainerContentChanging="MediaGrid_ContainerContentChanging" Loaded="MediaGrid_Loaded" Unloaded="MediaGrid_Unloaded"
                              SizeChanged="CollectionViewport_SizeChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Media items">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    </GridView>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="16" Margin="24" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="DetailScroller" Grid.Row="3" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,0,32">
                    <Grid x:Name="DetailHero" MinHeight="396" SizeChanged="DetailHero_SizeChanged">
                        <Grid.Background><SolidColorBrush Color="{ThemeResource DetailSurfaceColor}" /></Grid.Background>
                        <Canvas IsHitTestVisible="False">
                            <Image x:Name="DetailBackdrop" Tag="{x:Bind ViewModel.Detail, Mode=OneWay}" AutomationProperties.AutomationId="BackdropArtwork"
                                   Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" Opacity="0.7" />
                        </Canvas>
                        <Border>
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{ThemeResource DetailVeilColor}" Offset="0" />
                                <GradientStop Color="{ThemeResource DetailVeilColor}" Offset="0.5" />
                                <GradientStop Color="{ThemeResource DetailFadeColor}" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Border>
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.4" /><GradientStop Color="{ThemeResource DetailSurfaceColor}" Offset="1" />
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Border Background="{ThemeResource DetailAccessibilityOverlayBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="DetailLayout" Margin="32,24,32,28" ColumnSpacing="28" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DetailPosterColumn" Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="DetailPosterFrame" Width="216" Height="324" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid>
                                    <FontIcon Glyph="&#xE714;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="DetailPoster" Tag="{x:Bind ViewModel.Detail, Mode=OneWay}" Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DetailInformation" Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind ViewModel.Detail.Title, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Metadata, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Genres, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Detail.GenresVisibility, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PrimaryPlayButton" Style="{ThemeResource AccentButtonStyle}" Click="PrimaryPlay_Click" MinHeight="40"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryPlayHint, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.PrimaryPlayLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton IsChecked="{x:Bind ViewModel.Detail.IsFavorite, Mode=OneWay}" Click="Favorite_Click" Width="40" Height="40"
                                                  ToolTipService.ToolTip="{x:Bind ViewModel.Detail.FavoriteLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Detail.FavoriteLabel, Mode=OneWay}"
                                                  IsEnabled="{x:Bind ViewModel.CanEditDetails, Mode=OneWay}">
                                        <FontIcon Glyph="&#xEB51;" FontSize="18" />
                                    </ToggleButton>
                                    <ToggleButton IsChecked="{x:Bind ViewModel.Detail.IsPlayed, Mode=OneWay}" Click="Played_Click" Width="40" Height="40"
                                                  ToolTipService.ToolTip="{x:Bind ViewModel.Detail.PlayedLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.Detail.PlayedLabel, Mode=OneWay}"
                                                  IsEnabled="{x:Bind ViewModel.CanEditDetails, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                    </ToggleButton>
                                    <Button Width="40" Height="40" AutomationProperties.Name="More playback options" ToolTipService.ToolTip="More"
                                            Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE712;" FontSize="18" />
                                        <Button.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="Play from beginning" Click="Play_Click" Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}" />
                                            <MenuFlyoutItem Text="Add to queue" Click="Queue_Click" Visibility="{x:Bind ViewModel.PrimaryPlayVisibility, Mode=OneWay}" />
                                        </MenuFlyout></Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Detail.MediaFormat, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.Detail.MediaFormatVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Overview, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind ViewModel.Detail.Directors, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.Detail.DirectorsVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Margin="28,8,12,24" RowSpacing="16" Visibility="{x:Bind ViewModel.DetailChildrenVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="328" /></Grid.RowDefinitions>
                        <Grid Margin="4,0,16,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.DetailChildrenTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level2" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DetailChildrenTitle, Mode=OneWay}" />
                            <ComboBox x:Name="SeasonBox" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Seasons}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=OneWay}" MinWidth="144" MaxWidth="240"
                                      IsEnabled="{x:Bind ViewModel.CanSelectSeason, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.SeasonSelectorVisibility, Mode=OneWay}"
                                      SelectionChanged="SeasonBox_SelectionChanged" AutomationProperties.Name="Choose a season" />
                        </Grid>
                        <GridView x:Name="DetailItemsGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" MinHeight="328"
                                  ItemTemplate="{StaticResource EpisodeCardTemplate}" ItemContainerStyle="{StaticResource ShelfContainerStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick" ContainerContentChanging="MediaGrid_ContainerContentChanging"
                                  Loaded="DetailItemsGrid_Loaded" Unloaded="DetailItemsGrid_Unloaded" SizeChanged="CollectionViewport_SizeChanged"
                                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Seasons and episodes"
                                  Visibility="{x:Bind ViewModel.DetailItemsVisibility, Mode=OneWay}">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                        </GridView>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Margin="4,16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.DetailEmptyVisibility, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Margin="28,0,12,0" Spacing="16" Visibility="{x:Bind ViewModel.Detail.CastVisibility, Mode=OneWay}">
                        <TextBlock Text="Cast and crew" FontSize="20" FontWeight="SemiBold" Margin="4,0" AutomationProperties.HeadingLevel="Level2" />
                        <GridView x:Name="CastGrid" ItemsSource="{x:Bind ViewModel.Detail.Cast, Mode=OneWay}" MinHeight="248" ItemTemplate="{StaticResource PersonCardTemplate}"
                                  ItemContainerStyle="{StaticResource ShelfContainerStyle}" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False"
                                  ContainerContentChanging="MediaGrid_ContainerContentChanging" AutomationProperties.Name="Cast and crew"
                                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</UserControl>
