<ContentDialog
    x:Class="EmbyClient.App.Views.PlaybackDiagnosticsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Playback diagnostics" CloseButtonText="Close" DefaultButton="Close"
    PrimaryButtonText="Copy snapshot" PrimaryButtonClick="CopyClicked"
    SecondaryButtonText="Save snapshot" SecondaryButtonClick="SaveClicked">
    <Grid MaxWidth="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="Local events and media categories only. Snapshots exclude addresses, accounts, titles, paths, and tokens."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="RefreshClicked"
                    AutomationProperties.Name="Refresh" AutomationProperties.HelpText="Refresh playback diagnostics." />
        </Grid>
        <TextBox Grid.Row="3" x:Name="SummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" MinHeight="100" MaxHeight="240"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Safe playback diagnostic events" />
        <TextBlock Grid.Row="4" Text="Codec categories describe selected source metadata, not verified decoder output."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar Grid.Row="5" x:Name="ResultNotice" IsOpen="False" IsClosable="True" />
        <TextBlock Grid.Row="6" x:Name="StatusText" MinHeight="20" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</ContentDialog>
