<UserControl
    x:Class="EmbyClient.App.Views.MediaInformationSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels"
    xmlns:views="using:EmbyClient.App.Views">
    <StackPanel x:Name="SectionContent" Spacing="16" Visibility="{x:Bind Model.Visibility, Mode=OneWay}">
        <TextBlock Text="Media information" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
        <ComboBox x:Name="SourceSelector" ItemsSource="{x:Bind Model.Sources, Mode=OneWay}" SelectedItem="{x:Bind Model.SelectedSource, Mode=OneWay}"
                  SelectionChanged="SourceSelector_SelectionChanged" Visibility="{x:Bind Model.SourceSelectorVisibility, Mode=OneWay}"
                  HorizontalAlignment="Stretch" MaxWidth="640" AutomationProperties.Name="Media version"
                  Background="{ThemeResource DetailControlBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MediaSourceViewModel"><TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Model.SelectedSource.Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Model.SelectedSource.Summary, Mode=OneWay}" Foreground="{ThemeResource DetailSecondaryTextBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind Model.SelectedSource.SummaryVisibility, Mode=OneWay}" />
        </StackPanel>
        <Grid x:Name="CardsGrid" ColumnSpacing="16" RowSpacing="16" SizeChanged="CardsGrid_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <views:MediaStreamGroupView x:Name="VideoCard" Group="{x:Bind Model.SelectedSource.Video, Mode=OneWay}"
                                        Visibility="{x:Bind Model.SelectedSource.Video.Visibility, Mode=OneWay}" VerticalAlignment="Top" />
            <views:MediaStreamGroupView x:Name="AudioCard" Grid.Column="1" Group="{x:Bind Model.SelectedSource.Audio, Mode=OneWay}"
                                        Visibility="{x:Bind Model.SelectedSource.Audio.Visibility, Mode=OneWay}" VerticalAlignment="Top" />
            <views:MediaStreamGroupView x:Name="SubtitlesCard" Grid.Column="2" Group="{x:Bind Model.SelectedSource.Subtitles, Mode=OneWay}"
                                        Visibility="{x:Bind Model.SelectedSource.Subtitles.Visibility, Mode=OneWay}" VerticalAlignment="Top" />
        </Grid>
    </StackPanel>
</UserControl>
