<UserControl
    x:Class="EmbyClient.App.Views.MediaStreamGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyClient.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate" x:DataType="vm:MediaInformationField">
            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{ThemeResource DetailCardBackgroundBrush}" BorderBrush="{ThemeResource DetailCardStrokeBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
        <StackPanel Spacing="14">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Group.Icon, Mode=OneWay}" FontSize="16" IsTextScaleFactorEnabled="False" />
                <TextBlock Grid.Column="1" Text="{x:Bind Group.Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Grid.Column="2" Text="{x:Bind Group.CountLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource DetailSecondaryTextBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind Group.VisibleTracks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaStreamTrackViewModel">
                        <StackPanel Spacing="10">
                            <Border Height="1" Margin="0,6,0,6" Background="{ThemeResource DetailDividerBrush}" Visibility="{x:Bind DividerVisibility}" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" MaxWidth="420"
                                        Background="{ThemeResource DetailChipBackgroundBrush}" BorderBrush="{ThemeResource DetailChipStrokeBrush}" BorderThickness="1"
                                        Visibility="{x:Bind TagsVisibility}">
                                    <TextBlock Text="{x:Bind TagsLabel}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DetailSecondaryTextBrush}"
                                           Visibility="{x:Bind SummaryVisibility}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind Fields}" ItemTemplate="{StaticResource FieldTemplate}" />
                            <Expander Header="Technical details" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                      Visibility="{x:Bind TechnicalVisibility}" AutomationProperties.Name="{x:Bind TechnicalAutomationName}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="36"
                                      Padding="0,12,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <StaticResource x:Key="ExpanderChevronPointerOverBackground" ResourceKey="DetailControlHoverBrush" />
                                    <StaticResource x:Key="ExpanderChevronPressedBackground" ResourceKey="DetailControlBackgroundBrush" />
                                    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="DetailDividerBrush" />
                                    <StaticResource x:Key="ExpanderHeaderBorderPointerOverBrush" ResourceKey="DetailDividerBrush" />
                                    <StaticResource x:Key="ExpanderHeaderBorderPressedBrush" ResourceKey="DetailDividerBrush" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0,1,0,0</Thickness>
                                    <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
                                    <Thickness x:Key="ExpanderContentPadding">0,12,0,0</Thickness>
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                </Expander.Resources>
                                <ItemsControl ItemsSource="{x:Bind TechnicalFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ToggleButton Content="{x:Bind Group.ToggleLabel, Mode=OneWay}" IsChecked="{x:Bind Group.IsExpanded, Mode=OneWay}"
                          Click="ToggleTracks_Click" Visibility="{x:Bind Group.ToggleVisibility, Mode=OneWay}"
                          HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,6" MinHeight="32"
                          AutomationProperties.Name="{x:Bind Group.ToggleLabel, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
