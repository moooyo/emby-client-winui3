<UserControl x:Class="EmbyClient.App.Views.PlayerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:EmbyClient.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PlayerPrimaryBackground" Color="#F6F2EA" />
            <SolidColorBrush x:Key="PlayerPrimaryForeground" Color="#1F1606" />
            <SolidColorBrush x:Key="PlayerAccentBrush" Color="#E2B86B" />
            <SolidColorBrush x:Key="PlayerSubBrush" Color="#BFB8AC" />
            <Style x:Key="PlayerCommandStyle" TargetType="Button">
                <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10" /><Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#F6F2EA" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="CommandSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CommandSurface.Background" Value="#29FFFFFF" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CommandSurface.Background" Value="#3DFFFFFF" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CommandSurface.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="PlayerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerCommandStyle}">
                <Setter Property="Background" Value="{StaticResource PlayerPrimaryBackground}" /><Setter Property="Foreground" Value="{StaticResource PlayerPrimaryForeground}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="PrimarySurface.Opacity" Value="0.88" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PrimarySurface.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PrimarySurface.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="PlayerTrackRowStyle" TargetType="Button" BasedOn="{StaticResource PlayerCommandStyle}">
                <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="12,8" /><Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="TrackSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TrackSurface.Background" Value="#21FFFFFF" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TrackSurface.Background" Value="#29FFFFFF" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="TrackSurface.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="PlayerEpisodeRowStyle" TargetType="Button" BasedOn="{StaticResource PlayerTrackRowStyle}">
                <Setter Property="Height" Value="Auto" /><Setter Property="MinHeight" Value="88" /><Setter Property="Padding" Value="8" /><Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="PlayerPillStyle" TargetType="Button" BasedOn="{StaticResource PlayerTrackRowStyle}">
                <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="38" /><Setter Property="CornerRadius" Value="19" /><Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="Padding" Value="16,8" />
            </Style>
            <Style x:Key="PlayerSelectorStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#12FFFFFF" /><Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="Foreground" Value="#F6F2EA" /><Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="PlayerSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}"><Setter Property="MinHeight" Value="24" /><Setter Property="Height" Value="24" /></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PlayerRoot" RequestedTheme="Dark" Background="Black" SizeChanged="PlayerRootSizeChanged">
        <Grid.Resources>
            <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#F6F2EA" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E2B86B" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E2B86B" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E2B86B" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F6F2EA" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F6F2EA" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F6F2EA" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#EF1C1A17" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="FlyoutBackground" Color="#F21C1A17" />
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#24FFFFFF" />
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SideColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid x:Name="PlayerMain" Grid.ColumnSpan="2" SizeChanged="PlayerMainSizeChanged">
            <Grid x:Name="VideoStage" Background="Black">
                <MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False" IsHitTestVisible="False" Stretch="Uniform" />
                <Button x:Name="VideoFocusTarget" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="VideoSurfaceClicked" AutomationProperties.Name="Show playback controls"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template></Button>
                <StackPanel x:Name="StageStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24">
                    <ProgressRing x:Name="BufferingRing" Width="36" Height="36" IsActive="False" Foreground="{StaticResource PlayerAccentBrush}" AutomationProperties.Name="Loading playback" />
                    <TextBlock x:Name="StageStatusText" Text="Choose something to play" Foreground="#F6F2EA" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="StageMediaText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PlayerSubBrush}" />
                </StackPanel>
                <ScrollViewer x:Name="PlaybackNoticeHost" Visibility="Collapsed" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Center" MaxWidth="540" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="PlaybackNotice" IsOpen="False" IsClosable="False" Severity="Error" Title="Playback interrupted" Closed="PlaybackNoticeClosed" />
                        <TextBlock x:Name="RecoveryPositionText" Visibility="Collapsed" Foreground="#F6F2EA" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <Button x:Name="RetryButton" Content="Retry from last position" Click="RetryClicked" Style="{StaticResource PlayerPillStyle}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Retry playback from last position" />
                            <Button x:Name="ChangeRetrySettingsButton" Content="Change settings" Click="ChangeRetrySettingsClicked" Style="{StaticResource PlayerPillStyle}" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="ErrorSecondaryActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed"><Button x:Name="ErrorDiagnosticsButton" Content="Diagnostics" Click="DiagnosticsClicked" Style="{StaticResource PlayerPillStyle}" /><Button x:Name="ErrorBackButton" Content="Return to details" Click="BackClicked" Style="{StaticResource PlayerPillStyle}" /></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="PlayerHeader" Height="170" VerticalAlignment="Top" SizeChanged="PlayerHeaderSizeChanged">
                <Border x:Name="HeaderSurface" Visibility="Collapsed" Background="#EB0C0B0A" IsHitTestVisible="False" />
                <Border x:Name="HeaderGradient" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B3000000" Offset="0" /><GradientStop Color="#52000000" Offset="0.45" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                <Grid Height="64" Margin="20,0,160,0" VerticalAlignment="Top" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Width="40" Height="40" CornerRadius="20" Background="#24FFFFFF" Click="BackClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Return to details" ToolTipService.ToolTip="Return to details"><Image Width="20" Height="20"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/arrow_left_20_regular.svg" /></Image.Source></Image></Button>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="TitleText" Text="Now playing" FontSize="17" FontWeight="SemiBold" Foreground="#F6F2EA" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind TitleText.Text, Mode=OneWay}" /><TextBlock x:Name="EpisodeIdentityText" FontSize="12" Foreground="{StaticResource PlayerSubBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Border x:Name="StreamInfoPill" Grid.Column="2" VerticalAlignment="Center" MaxWidth="400" MinHeight="30" Background="#59000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" Padding="12,6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse x:Name="StreamOnlineDot" Width="6" Height="6" Fill="#3FCF7A" VerticalAlignment="Center" /><TextBlock x:Name="StateText" Grid.Column="1" Text="Choose something to play" FontSize="12" Foreground="#F6F2EA" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="|" Foreground="#66FFFFFF" FontSize="12" VerticalAlignment="Center" /><TextBlock x:Name="StreamInfoText" Grid.Column="3" FontSize="12" Foreground="#F6F2EA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid></Border>
                    <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" AutomationProperties.Name="More playback options" ToolTipService.ToolTip="More playback options">
                        <Image Width="20" Height="20"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/more_horizontal_20_regular.svg" /></Image.Source></Image>
                        <Button.Flyout><MenuFlyout x:Name="MoreMenu" Opening="QuickFlyoutOpening" Closed="QuickFlyoutClosed"><MenuFlyoutItem Text="Restart from beginning" Click="ReplayClicked" /><MenuFlyoutItem Text="Previous episode" Click="PreviousEpisodeClicked" /><MenuFlyoutItem Text="Play queue" Click="QueueClicked" /><MenuFlyoutItem Text="Playback settings" Click="PlaybackSettingsClicked" /><MenuFlyoutSeparator /><MenuFlyoutItem x:Name="DiagnosticsButton" Text="Playback diagnostics" Click="DiagnosticsClicked" /></MenuFlyout></Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
            <Grid x:Name="ControlDock" Height="320" VerticalAlignment="Bottom" Padding="44,0,44,22">
                <Border x:Name="DockSurface" Margin="-44,0,-44,-22" Visibility="Collapsed" Background="#EB0C0B0A" IsHitTestVisible="False" />
                <Border x:Name="DockGradient" Margin="-44,0,-44,-22" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#ED000000" Offset="0" /><GradientStop Color="#99000000" Offset="0.5" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                <Border x:Name="ChapterPreview" Width="208" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,114" Background="#F20C0B0A" BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"><StackPanel><Border Height="117" CornerRadius="7,7,0,0"><Image x:Name="ChapterPreviewImage" Stretch="UniformToFill" /></Border><TextBlock x:Name="ChapterPreviewText" Margin="8,6" Foreground="#F6F2EA" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                <Grid x:Name="TimelineHost" Height="28" Margin="12,0,12,60" VerticalAlignment="Bottom"><Slider x:Name="Timeline" Minimum="0" Maximum="1" IsEnabled="False" AutomationProperties.Name="Playback position" Style="{StaticResource PlayerSliderStyle}" LostFocus="TimelineLostFocus" PointerMoved="TimelinePointerMoved" PointerExited="TimelinePointerExited" /><Canvas x:Name="ChapterTicks" Margin="8,0" IsHitTestVisible="False" VerticalAlignment="Center" Height="4" /></Grid>
                <Grid x:Name="TransportRow" Height="52" VerticalAlignment="Bottom" ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="TransportButtons" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Width="52" Height="52" CornerRadius="26" Padding="14" Margin="0,0,6,0" Click="PauseClicked" Style="{StaticResource PlayerPrimaryButtonStyle}" AutomationProperties.Name="Pause" ToolTipService.ToolTip="Pause"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/d/pause_24_filled.svg" /></Image.Source></Image></Button>
                        <Button x:Name="PreviousEpisodeButton" Click="PreviousEpisodeClicked" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Previous episode" ToolTipService.ToolTip="Previous episode"><Image Width="20" Height="20" RenderTransformOrigin="0.5,0.5"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/next_24_filled.svg" /></Image.Source><Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform></Image></Button>
                        <Button x:Name="RewindButton" Click="RewindClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Back 10 seconds" ToolTipService.ToolTip="Back 10 seconds"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/skip_back_10_24_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="ForwardButton" Click="ForwardClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Forward 30 seconds" ToolTipService.ToolTip="Forward 30 seconds"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/skip_forward_30_24_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="NextEpisodeButton" Click="NextEpisodeClicked" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Next episode" ToolTipService.ToolTip="Next episode"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/next_24_filled.svg" /></Image.Source></Image></Button>
                    </StackPanel>
                    <StackPanel x:Name="VolumeGroup" Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button x:Name="VolumeButton" Click="VolumeButtonClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute"><Image Width="20" Height="20"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/speaker_2_24_regular.svg" /></Image.Source></Image></Button>
                        <Slider x:Name="Volume" Width="92" Minimum="0" Maximum="100" Value="100" Style="{StaticResource PlayerSliderStyle}" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Foreground="#F6F2EA"><Slider.Resources><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#F6F2EA" /><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#F6F2EA" /></Slider.Resources></Slider>
                        <ToggleButton x:Name="MuteButton" Visibility="Collapsed" IsTabStop="False" Click="MuteClicked" AutomationProperties.Name="Mute" />
                    </StackPanel>
                    <StackPanel x:Name="TimeReadout" Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="PositionText" Text="0:00" FontSize="14" Foreground="#F6F2EA" Typography.NumeralAlignment="Tabular" /><TextBlock Text="/" FontSize="14" Foreground="#8E877C" /><TextBlock x:Name="DurationText" Text="--:--" FontSize="14" Foreground="#BFB8AC" Typography.NumeralAlignment="Tabular" /></StackPanel>
                    <StackPanel x:Name="UtilityButtons" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="EpisodeDrawerButton" Click="EpisodeDrawerClicked" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" AutomationProperties.Name="Episodes" ToolTipService.ToolTip="Episodes"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/apps_list_20_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="SubtitleButton" Click="TracksClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Audio and subtitles" ToolTipService.ToolTip="Audio and subtitles"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/closed_caption_24_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="RateButton" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Playback speed" ToolTipService.ToolTip="Playback speed"><TextBlock x:Name="RateText" Text="1.0x" FontSize="13" FontWeight="SemiBold" /><Button.Flyout><MenuFlyout x:Name="RateMenu" Opening="RateMenuOpening" Closed="QuickFlyoutClosed" /></Button.Flyout></Button>
                        <Button x:Name="PictureInPictureButton" Click="PictureInPictureClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Picture in picture" ToolTipService.ToolTip="Picture in picture"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/picture_in_picture_24_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Enter fullscreen" ToolTipService.ToolTip="Enter fullscreen"><Image Width="24" Height="24"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/full_screen_maximize_24_regular.svg" /></Image.Source></Image></Button>
                        <Button x:Name="QualityButton" Click="PlaybackSettingsClicked" Visibility="Collapsed" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Maximum bitrate"><TextBlock x:Name="QualityText" Text="20 Mbps" FontSize="12" /><Button.Flyout><MenuFlyout x:Name="QualityMenu" Opening="QualityMenuOpening" Closed="QuickFlyoutClosed" /></Button.Flyout></Button>
                        <Button x:Name="QueueButton" Click="QueueClicked" Visibility="Collapsed" Style="{StaticResource PlayerCommandStyle}" IsEnabled="False" AutomationProperties.Name="Open queue"><TextBlock x:Name="QueueCountText" Text="0" FontSize="12" /></Button>
                        <Button x:Name="PlaybackSettingsButton" Click="PlaybackSettingsClicked" Visibility="Collapsed" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Playback settings"><Image Width="20" Height="20"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/options_20_regular.svg" /></Image.Source></Image></Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="SubtitleOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="64,0,64,190" IsHitTestVisible="False" MaxWidth="1100" SizeChanged="CaptionLayoutSizeChanged">
                <TextBlock x:Name="SubtitleOutlineText" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="#F0000000" Margin="1,2,-1,-2" />
                <TextBlock x:Name="SubtitleOutlineLeft" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="Black" Margin="-1,0,1,0" />
                <TextBlock x:Name="SubtitleOutlineRight" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="Black" Margin="1,0,-1,0" />
                <TextBlock x:Name="SubtitleOutlineTop" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="Black" Margin="0,-1,0,1" />
                <TextBlock x:Name="SubtitleOutlineBottom" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="Black" Margin="0,1,0,-1" />
                <TextBlock x:Name="SubtitleText" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" FontWeight="SemiBold" Foreground="#F6F2EA" />
            </Grid>
            <Button x:Name="SkipIntroButton" Click="SkipIntroClicked" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,128" Style="{StaticResource PlayerPillStyle}" AutomationProperties.Name="Skip intro"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="SkipIntroText" Text="Skip intro" /><Image Width="18" Height="18"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/chevron_right_20_regular.svg" /></Image.Source></Image></StackPanel></Button>
            <Border x:Name="NextEpisodeCountdown" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,128" CornerRadius="16" Background="#EB1C1A17" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="20,16"><StackPanel Spacing="10" MaxWidth="280"><TextBlock x:Name="NextCountdownText" Foreground="#F6F2EA" FontSize="14" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Play next episode" Click="CountdownPlayNextClicked" Style="{StaticResource PlayerPillStyle}" /><Button Content="Cancel" Click="CountdownCancelClicked" Style="{StaticResource PlayerPillStyle}" /></StackPanel></StackPanel></Border>
        </Grid>
        <Button x:Name="PanelScrim" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" IsTabStop="False" Click="CloseSidePanelClicked" AutomationProperties.AccessibilityView="Raw"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Button.Template></Button>
        <Border x:Name="SidePanel" Grid.ColumnSpan="2" Width="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,64,44,118" Visibility="Collapsed" Background="#E81C1A17" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" SizeChanged="CaptionLayoutSizeChanged">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions><RowDefinition x:Name="SidePanelHeaderRow" Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="SidePanelHeader" Padding="18,12" ColumnSpacing="8" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidePanelTitle" Text="Playback settings" FontSize="16" FontWeight="SemiBold" Foreground="#F6F2EA" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel x:Name="EpisodeSeasonHeading" Orientation="Horizontal" Spacing="12" Visibility="Collapsed" VerticalAlignment="Center"><ComboBox x:Name="EpisodeSeasonSelector" MinWidth="120" MaxWidth="220" SelectionChanged="EpisodeSeasonChanged" Style="{StaticResource PlayerSelectorStyle}" AutomationProperties.Name="Season" /><TextBlock x:Name="EpisodeCountText" Foreground="#BFB8AC" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    <Button x:Name="CloseSidePanelButton" Grid.Column="1" Width="32" Height="32" Padding="8" Click="CloseSidePanelClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Close playback panel" ToolTipService.ToolTip="Close"><Image Width="16" Height="16"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/dismiss_20_regular.svg" /></Image.Source></Image></Button>
                </Grid>
                <Grid x:Name="TrackPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer x:Name="TrackListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Padding="10,14,8,10" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,0"><Image Width="16" Height="16" Opacity="0.7"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/headphones_20_regular.svg" /></Image.Source></Image><TextBlock x:Name="AudioTrackHeading" Text="Audio" FontSize="12" FontWeight="SemiBold" Foreground="#BFB8AC" /></StackPanel><StackPanel x:Name="AudioTrackItems" Spacing="0" /></StackPanel>
                        <Border Grid.Column="1" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0"><StackPanel Padding="8,14,10,10" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,0"><Image Width="16" Height="16" Opacity="0.7"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/closed_caption_24_regular.svg" /></Image.Source></Image><TextBlock x:Name="SubtitleTrackHeading" Text="Subtitles" FontSize="12" FontWeight="SemiBold" Foreground="#BFB8AC" /></StackPanel><StackPanel x:Name="SubtitleTrackItems" Spacing="0" /></StackPanel></Border>
                    </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Padding="14,10" ColumnSpacing="10" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Image Width="16" Height="16" Opacity="0.7"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/text_font_20_regular.svg" /></Image.Source></Image><TextBlock Text="Size" Foreground="#BFB8AC" FontSize="12" VerticalAlignment="Center" /><Button x:Name="SubtitleSmallButton" Content="Small" Tag="Small" Click="SubtitleSizeClicked" Style="{StaticResource PlayerPillStyle}" Height="28" Padding="6,2" IsEnabled="False" /><Button x:Name="SubtitleMediumButton" Content="Medium" Tag="Medium" Click="SubtitleSizeClicked" Style="{StaticResource PlayerPillStyle}" Height="28" Padding="6,2" IsEnabled="False" /><Button x:Name="SubtitleLargeButton" Content="Large" Tag="Large" Click="SubtitleSizeClicked" Style="{StaticResource PlayerPillStyle}" Height="28" Padding="6,2" IsEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Delay" Foreground="#BFB8AC" FontSize="12" VerticalAlignment="Center" /><Button x:Name="SubtitleDelayBackward" Click="SubtitleDelayBackwardClicked" Width="24" Height="28" Padding="2" Style="{StaticResource PlayerCommandStyle}" IsEnabled="False" ToolTipService.ToolTip="Show subtitles 0.1 seconds earlier"><Image Width="14" Height="14"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/subtract_16_regular.svg" /></Image.Source></Image></Button><TextBlock x:Name="SubtitleDelayText" Text="0.0s" Foreground="#BFB8AC" FontSize="12" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center" /><Button x:Name="SubtitleDelayForward" Click="SubtitleDelayForwardClicked" Width="24" Height="28" Padding="2" Style="{StaticResource PlayerCommandStyle}" IsEnabled="False" ToolTipService.ToolTip="Show subtitles 0.1 seconds later"><Image Width="14" Height="14"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Lumen/Icons/w/add_16_regular.svg" /></Image.Source></Image></Button></StackPanel>
                        <Button x:Name="ExternalSubtitleButton" Grid.Column="2" Content="External subtitles" Click="ExternalSubtitleClicked" Style="{StaticResource PlayerPillStyle}" Height="28" Padding="8,2" FontSize="11" IsEnabled="False" ToolTipService.ToolTip="Open local WebVTT subtitles" />
                    </Grid>
                    <TextBlock x:Name="SubtitleRenderingNotice" Grid.Row="2" Margin="16,0,16,12" Text="Subtitle appearance and timing are controlled by the server." FontSize="11" Foreground="#8E877C" TextWrapping="Wrap" />
                </Grid>
                <Grid x:Name="EpisodesPanel" Grid.Row="1" Visibility="Collapsed"><ScrollViewer x:Name="EpisodeDrawerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,10"><StackPanel x:Name="EpisodeDrawerItems" Spacing="4" /></ScrollViewer><TextBlock x:Name="EpisodeDrawerStatus" Foreground="#BFB8AC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" AutomationProperties.LiveSetting="Polite" /></Grid>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel Spacing="20">
                        <TextBlock x:Name="RetrySettingsContext" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#BFB8AC" />
                        <StackPanel Spacing="4"><TextBlock x:Name="SettingsMediaText" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F6F2EA" /><TextBlock x:Name="SettingsIdentityText" FontSize="12" TextWrapping="Wrap" Foreground="#BFB8AC" /></StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Current media" FontWeight="SemiBold" Foreground="#F6F2EA" AutomationProperties.HeadingLevel="Level3" />
                            <StackPanel x:Name="SourceReadOnly" Spacing="4"><TextBlock Text="Version" Foreground="#BFB8AC" /><TextBlock x:Name="SourceValue" Text="No version available" TextWrapping="Wrap" Foreground="#F6F2EA" IsTextSelectionEnabled="True" /></StackPanel>
                            <ComboBox x:Name="SourceSelector" Header="Version" PlaceholderText="Server default" SelectionChanged="SourceChanged" Style="{StaticResource PlayerSelectorStyle}" AutomationProperties.Name="Playback version" Visibility="Collapsed" />
                            <StackPanel x:Name="AudioReadOnly" Spacing="4"><TextBlock Text="Audio" Foreground="#BFB8AC" /><TextBlock x:Name="AudioValue" Text="No audio track" TextWrapping="Wrap" Foreground="#F6F2EA" /></StackPanel>
                            <ComboBox x:Name="AudioSelector" Header="Audio" SelectionChanged="AudioChanged" Style="{StaticResource PlayerSelectorStyle}" AutomationProperties.Name="Audio track" Visibility="Collapsed" />
                            <StackPanel x:Name="SubtitleReadOnly" Spacing="4"><TextBlock Text="Subtitles" Foreground="#BFB8AC" /><TextBlock x:Name="SubtitleValue" Text="Off" TextWrapping="Wrap" Foreground="#F6F2EA" /></StackPanel>
                            <ComboBox x:Name="SubtitleSelector" Header="Subtitles" SelectionChanged="SubtitleChanged" Style="{StaticResource PlayerSelectorStyle}" AutomationProperties.Name="Subtitle track" Visibility="Collapsed" />
                            <ComboBox x:Name="QualitySelector" Header="Maximum bitrate" SelectionChanged="QualityChanged" Style="{StaticResource PlayerSelectorStyle}" AutomationProperties.Name="Maximum bitrate" />
                            <TextBlock x:Name="QualityLimitText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="#BFB8AC" />
                        </StackPanel>
                        <Border Height="1" Background="#1FFFFFFF" />
                        <ToggleSwitch x:Name="ReserveControlArea" Visibility="Collapsed" Toggled="ReserveControlAreaToggled" AutomationProperties.Name="Reserve space for controls" />
                        <ToggleSwitch x:Name="AutoPlayNext" Header="Continue automatically" IsOn="True" Toggled="AutoPlayNextToggled" AutomationProperties.Name="Continue automatically" />
                        <Button Content="Playback diagnostics" Click="DiagnosticsClicked" Style="{StaticResource PlayerPillStyle}" />
                        <Button Content="Restart from beginning" Click="ReplayClicked" Style="{StaticResource PlayerPillStyle}" />
                        <Button Content="Play queue" Click="QueueClicked" Style="{StaticResource PlayerPillStyle}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="QueuePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4"><TextBlock Text="Now playing" FontSize="12" Foreground="#BFB8AC" /><TextBlock x:Name="QueueNowPlayingText" Text="No active playback" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#F6F2EA" /></StackPanel>
                        <StackPanel Spacing="4"><TextBlock Text="Queued by you" FontWeight="SemiBold" Foreground="#F6F2EA" AutomationProperties.HeadingLevel="Level3" /><TextBlock x:Name="QueueSummaryText" Text="0 queued items" FontSize="12" Foreground="#BFB8AC" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                        <Grid MinHeight="64">
                            <TextBlock x:Name="QueueEmptyText" Text="Your queue is empty. Add a movie or episode from the library." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#BFB8AC" />
                            <ListView x:Name="QueueList" SelectionMode="Single" SelectionChanged="QueueSelectionChanged" KeyDown="QueueListKeyDown" ContainerContentChanging="QueueContainerContentChanging" Foreground="#F6F2EA" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Queued by you" AutomationProperties.HelpText="Select an item to move or remove it. Press Delete to remove it.">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="services:PlaybackQueueEntry"><Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="OrderText" MinWidth="24" Foreground="#BFB8AC" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#F6F2EA" AutomationProperties.AccessibilityView="Raw" /><TextBlock x:Name="QueueDetailText" Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" Foreground="#BFB8AC" AutomationProperties.AccessibilityView="Raw" /><TextBlock x:Name="NextText" Text="Next in queue" FontSize="12" Foreground="{StaticResource PlayerAccentBrush}" AutomationProperties.AccessibilityView="Raw" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <StackPanel x:Name="QueueActions" Spacing="8"><CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" AutomationProperties.Name="Queue actions"><AppBarButton x:Name="QueueMoveUpButton" Label="Move up" Click="QueueMoveUpClicked" AutomationProperties.Name="Move selected item up"><AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="QueueMoveDownButton" Label="Move down" Click="QueueMoveDownClicked" AutomationProperties.Name="Move selected item down"><AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="QueueRemoveButton" Label="Remove" Icon="Remove" Click="QueueRemoveClicked" /><CommandBar.SecondaryCommands><AppBarButton x:Name="QueueClearButton" Label="Clear queue" Icon="Clear" Click="QueueClearClicked" AutomationProperties.HelpText="Clear queue. Media files are kept." /></CommandBar.SecondaryCommands></CommandBar></StackPanel>
                        <StackPanel x:Name="NextEpisodeSection" Spacing="8" Visibility="Collapsed"><TextBlock Text="Next episode" FontWeight="SemiBold" Foreground="#F6F2EA" AutomationProperties.HeadingLevel="Level3" /><TextBlock x:Name="NextEpisodeText" Text="No next episode is available." TextWrapping="Wrap" Foreground="#BFB8AC" /><Button x:Name="QueueNextEpisodeButton" Content="Play next episode" Click="NextEpisodeClicked" Style="{StaticResource PlayerPillStyle}" IsEnabled="False" /></StackPanel>
                        <StackPanel Spacing="8"><ToggleSwitch x:Name="QueueAutoPlayNext" Header="Continue automatically" IsOn="True" Toggled="QueueAutoPlayNextToggled" AutomationProperties.Name="Continue automatically" /><TextBlock x:Name="QueueAutoPlayDescription" Text="Your queue plays first. The next episode is resolved when the queue is empty." FontSize="12" TextWrapping="Wrap" Foreground="#BFB8AC" /></StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="QueueFooter" Grid.Row="2" Margin="20,0,20,16" Spacing="8" Visibility="Collapsed"><Button x:Name="QueuePlayNextButton" Content="Play next in queue" Click="NextClicked" Style="{StaticResource PlayerPillStyle}" IsEnabled="False" /><TextBlock x:Name="QueueNextDescription" TextWrapping="Wrap" FontSize="12" Foreground="#BFB8AC" /></StackPanel>
                <StackPanel x:Name="RetrySettingsFooter" Grid.Row="2" Margin="20,0,20,16" Spacing="8" Visibility="Collapsed"><Button x:Name="ApplyRetryButton" Content="Apply and retry" Click="ApplyRetryClicked" Style="{StaticResource PlayerPillStyle}" /><Button Content="Cancel" Click="CancelRetrySettingsClicked" Style="{StaticResource PlayerPillStyle}" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
