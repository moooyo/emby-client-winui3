<UserControl
    x:Class="EmbyClient.App.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EmbyClient.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PlayerPrimaryBackground" Color="#242424" />
                    <SolidColorBrush x:Key="PlayerPrimaryForeground" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PlayerPrimaryBackground" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="PlayerPrimaryForeground" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PlayerPrimaryBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PlayerPrimaryForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PlayerCommandStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="40" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PlayerRoot" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="PlayerRootSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SideColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid x:Name="PlayerMain" SizeChanged="PlayerMainSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="VideoStage" Grid.Row="1" Background="Black" MinHeight="120">
                <MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False" IsHitTestVisible="False" Stretch="Uniform" />
                <Button x:Name="VideoFocusTarget" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                        Click="VideoSurfaceClicked" AutomationProperties.Name="Show playback controls">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    </Button.Resources>
                </Button>
                <StackPanel x:Name="StageStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24">
                    <ProgressRing x:Name="BufferingRing" Width="40" Height="40" IsActive="False" AutomationProperties.Name="Loading playback" />
                    <TextBlock x:Name="StageStatusText" Text="Choose something to play" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="StageMediaText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ScrollViewer x:Name="PlaybackNoticeHost" Visibility="Collapsed" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Center" MaxWidth="540" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="12">
                    <InfoBar x:Name="PlaybackNotice" IsOpen="False" IsClosable="False" Severity="Error" Title="Playback interrupted" Closed="PlaybackNoticeClosed" />
                    <TextBlock x:Name="RecoveryPositionText" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" />
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="RetryButton" Content="Retry from last position" Click="RetryClicked" Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Retry playback from last position" />
                        <Button x:Name="ChangeRetrySettingsButton" Content="Change settings" Click="ChangeRetrySettingsClicked" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="ErrorSecondaryActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <Button Content="Diagnostics" Click="DiagnosticsClicked" Style="{StaticResource SubtleButtonStyle}" />
                        <Button Content="Return to details" Click="BackClicked" Style="{StaticResource SubtleButtonStyle}" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="PlayerHeader" Padding="12,6" MinHeight="48" ColumnSpacing="12" SizeChanged="PlayerHeaderSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="HeaderSurface" Grid.ColumnSpan="4" Margin="-12,-6" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
                <Border x:Name="HeaderGradient" Grid.ColumnSpan="4" Margin="-12,-6" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EB000000" Offset="0" /><GradientStop Color="#BE000000" Offset="0.6" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <Button x:Name="BackButton" Click="BackClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Return to details" ToolTipService.ToolTip="Return to details"><SymbolIcon Symbol="Back" /></Button>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="Now playing" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" ToolTipService.ToolTip="{x:Bind TitleText.Text, Mode=OneWay}" />
                <TextBlock x:Name="StateText" Grid.Column="2" Text="Choose something to play" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="More playback options" ToolTipService.ToolTip="More playback options">
                    <SymbolIcon Symbol="More" />
                    <Button.Flyout><MenuFlyout x:Name="MoreMenu" Opening="QuickFlyoutOpening" Closed="QuickFlyoutClosed">
                        <MenuFlyoutItem Text="Restart from beginning" Click="ReplayClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Play queue" Click="QueueClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="List" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Playback settings" Click="PlaybackSettingsClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator /><MenuFlyoutItem x:Name="DiagnosticsButton" Text="Playback diagnostics" Click="DiagnosticsClicked" />
                    </MenuFlyout></Button.Flyout>
                </Button>
            </Grid>
            <Grid x:Name="ControlDock" Grid.Row="2" Padding="20,0,20,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="DockSurface" Grid.RowSpan="2" Margin="-20,0,-20,-12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
                <Border x:Name="DockGradient" Grid.RowSpan="2" Margin="-20,0,-20,-12" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#EB000000" Offset="0" /><GradientStop Color="#BE000000" Offset="0.6" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid MinWidth="48">
                        <TextBlock Text="00:00:00" FontSize="12" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="PositionText" Text="0:00" FontSize="12" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" AutomationProperties.Name="Playback position" LostFocus="TimelineLostFocus" />
                    <Grid Grid.Column="2" MinWidth="48">
                        <TextBlock Text="00:00:00" FontSize="12" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="DurationText" Text="--:--" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
                <Grid x:Name="TransportRow" Grid.Row="1" ColumnSpacing="4" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="VolumeButton" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume">
                        <SymbolIcon Symbol="Volume" />
                        <Button.Flyout><Flyout Placement="TopEdgeAlignedLeft" Opening="QuickFlyoutOpening" Closed="QuickFlyoutClosed">
                            <StackPanel Width="200" Spacing="12"><TextBlock Text="Volume" FontWeight="SemiBold" />
                                <Slider x:Name="Volume" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" />
                                <ToggleButton x:Name="MuteButton" Click="MuteClicked" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute"><SymbolIcon Symbol="Volume" /></ToggleButton>
                            </StackPanel>
                        </Flyout></Button.Flyout>
                    </Button>
                    <StackPanel x:Name="TransportButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="PreviousEpisodeButton" Click="PreviousEpisodeClicked" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Previous episode" ToolTipService.ToolTip="Previous episode"><SymbolIcon Symbol="Previous" /></Button>
                        <Button x:Name="RewindButton" Click="RewindClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Back 10 seconds" ToolTipService.ToolTip="Back 10 seconds (Left arrow)"><TextBlock Text="&#x2212;10s" FontSize="14" FontWeight="SemiBold" /></Button>
                        <Button x:Name="PauseButton" Width="48" Height="48" CornerRadius="24" Padding="12" Click="PauseClicked"
                                Background="{ThemeResource PlayerPrimaryBackground}" Foreground="{ThemeResource PlayerPrimaryForeground}"
                                AutomationProperties.Name="Pause" ToolTipService.ToolTip="Pause"><SymbolIcon Symbol="Pause" /></Button>
                        <Button x:Name="ForwardButton" Click="ForwardClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Forward 10 seconds" ToolTipService.ToolTip="Forward 10 seconds (Right arrow)"><TextBlock Text="+10s" FontSize="14" FontWeight="SemiBold" /></Button>
                        <Button x:Name="NextEpisodeButton" Click="NextEpisodeClicked" Style="{StaticResource PlayerCommandStyle}" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Next episode" ToolTipService.ToolTip="Next episode"><SymbolIcon Symbol="Next" /></Button>
                    </StackPanel>
                    <StackPanel x:Name="UtilityButtons" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="SubtitleButton" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Audio and subtitles" ToolTipService.ToolTip="Audio and subtitles">
                            <FontIcon Glyph="&#xE7F0;" FontSize="18" /><Button.Flyout><MenuFlyout x:Name="SubtitleMenu" Opening="SubtitleMenuOpening" Closed="QuickFlyoutClosed" /></Button.Flyout>
                        </Button>
                        <Button x:Name="QualityButton" MinHeight="40" Padding="8" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Maximum bitrate" ToolTipService.ToolTip="Maximum bitrate">
                            <TextBlock x:Name="QualityText" Text="20 Mbps" FontSize="12" /><Button.Flyout><MenuFlyout x:Name="QualityMenu" Opening="QualityMenuOpening" Closed="QuickFlyoutClosed" /></Button.Flyout>
                        </Button>
                        <Button x:Name="QueueButton" Click="QueueClicked" MinHeight="40" Padding="8" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False" AutomationProperties.Name="Open queue" ToolTipService.ToolTip="Queue (0)">
                            <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="List" /><TextBlock x:Name="QueueCountText" Text="0" VerticalAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular" /></StackPanel>
                        </Button>
                        <Button x:Name="PlaybackSettingsButton" Click="PlaybackSettingsClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Playback settings" ToolTipService.ToolTip="Playback settings"><SymbolIcon Symbol="Setting" /></Button>
                        <Button x:Name="FullscreenButton" Click="FullscreenClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Enter fullscreen" ToolTipService.ToolTip="Enter fullscreen (F11)"><SymbolIcon Symbol="FullScreen" /></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Button x:Name="PanelScrim" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#66000000" BorderThickness="0" IsTabStop="False" Click="CloseSidePanelClicked" AutomationProperties.AccessibilityView="Raw" />
        <Border x:Name="SidePanel" Grid.Column="1" Width="360" HorizontalAlignment="Right" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid Padding="20" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidePanelTitle" Text="Playback settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                    <Button x:Name="CloseSidePanelButton" Grid.Column="1" Click="CloseSidePanelClicked" Style="{StaticResource PlayerCommandStyle}" AutomationProperties.Name="Close playback panel" ToolTipService.ToolTip="Close (Escape)"><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <TextBlock x:Name="RetrySettingsContext" Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Spacing="4"><TextBlock x:Name="SettingsMediaText" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SettingsIdentityText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Current media" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                            <StackPanel x:Name="SourceReadOnly" Spacing="4"><TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SourceValue" Text="No version available" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                            <ComboBox x:Name="SourceSelector" Header="Version" PlaceholderText="Server default" HorizontalAlignment="Stretch" SelectionChanged="SourceChanged" AutomationProperties.Name="Playback version" Visibility="Collapsed" />
                            <StackPanel x:Name="AudioReadOnly" Spacing="4"><TextBlock Text="Audio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="AudioValue" Text="No audio track" TextWrapping="Wrap" /></StackPanel>
                            <ComboBox x:Name="AudioSelector" Header="Audio" HorizontalAlignment="Stretch" SelectionChanged="AudioChanged" AutomationProperties.Name="Audio track" Visibility="Collapsed" />
                            <StackPanel x:Name="SubtitleReadOnly" Spacing="4"><TextBlock Text="Subtitles" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SubtitleValue" Text="Off" TextWrapping="Wrap" /></StackPanel>
                            <ComboBox x:Name="SubtitleSelector" Header="Subtitles" HorizontalAlignment="Stretch" SelectionChanged="SubtitleChanged" AutomationProperties.Name="Subtitle track" Visibility="Collapsed" />
                            <ComboBox x:Name="QualitySelector" Header="Maximum bitrate" HorizontalAlignment="Stretch" SelectionChanged="QualityChanged" AutomationProperties.Name="Maximum bitrate" />
                            <TextBlock x:Name="QualityLimitText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Viewing" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                            <ToggleSwitch x:Name="ReserveControlArea" Toggled="ReserveControlAreaToggled" AutomationProperties.Name="Reserve space for controls"><ToggleSwitch.Header><TextBlock Text="Reserve space for controls" TextWrapping="Wrap" /></ToggleSwitch.Header></ToggleSwitch>
                            <TextBlock Text="Keeps fullscreen controls below the picture." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8"><ToggleSwitch x:Name="AutoPlayNext" IsOn="True" Toggled="AutoPlayNextToggled" AutomationProperties.Name="Continue automatically"><ToggleSwitch.Header><TextBlock Text="Continue automatically" TextWrapping="Wrap" /></ToggleSwitch.Header></ToggleSwitch><TextBlock Text="Uses your queue first, then the next available episode." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <TextBlock Text="More" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                        <Button Content="Playback diagnostics" Click="DiagnosticsClicked" HorizontalAlignment="Left" />
                        <Button Content="Restart from beginning" Click="ReplayClicked" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="QueuePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="4"><TextBlock Text="Now playing" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="QueueNowPlayingText" Text="No active playback" TextWrapping="Wrap" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Spacing="4"><TextBlock Text="Queued by you" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" /><TextBlock x:Name="QueueSummaryText" Text="0 queued items" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    <Grid MinHeight="64">
                        <TextBlock x:Name="QueueEmptyText" Text="Your queue is empty. Add a movie or episode from the library." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="QueueList" SelectionMode="Single" SelectionChanged="QueueSelectionChanged" KeyDown="QueueListKeyDown" ContainerContentChanging="QueueContainerContentChanging" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Queued by you" AutomationProperties.HelpText="Select an item to move or remove it. Press Delete to remove it.">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate x:DataType="services:PlaybackQueueEntry"><Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="OrderText" MinWidth="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw" /><TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" /><TextBlock x:Name="NextText" Text="Next in queue" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <StackPanel x:Name="QueueActions" Spacing="8">
                        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" AutomationProperties.Name="Queue actions">
                            <AppBarButton x:Name="QueueMoveUpButton" Label="Move up" Click="QueueMoveUpClicked" AutomationProperties.Name="Move selected item up"><AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton x:Name="QueueMoveDownButton" Label="Move down" Click="QueueMoveDownClicked" AutomationProperties.Name="Move selected item down"><AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton x:Name="QueueRemoveButton" Label="Remove" Icon="Remove" Click="QueueRemoveClicked" />
                            <CommandBar.SecondaryCommands><AppBarButton x:Name="QueueClearButton" Label="Clear queue" Icon="Clear" Click="QueueClearClicked" AutomationProperties.HelpText="Clear queue. Media files are kept." /></CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                    <StackPanel x:Name="NextEpisodeSection" Spacing="8" Visibility="Collapsed"><TextBlock Text="Next episode" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" /><TextBlock x:Name="NextEpisodeText" Text="No next episode is available." TextWrapping="Wrap" /><Button x:Name="QueueNextEpisodeButton" Content="Play next episode" Click="NextEpisodeClicked" HorizontalAlignment="Stretch" IsEnabled="False" /></StackPanel>
                    <StackPanel Spacing="8"><ToggleSwitch x:Name="QueueAutoPlayNext" IsOn="True" Toggled="QueueAutoPlayNextToggled" AutomationProperties.Name="Continue automatically"><ToggleSwitch.Header><TextBlock Text="Continue automatically" TextWrapping="Wrap" /></ToggleSwitch.Header></ToggleSwitch><TextBlock x:Name="QueueAutoPlayDescription" Text="Your queue plays first. The next episode is resolved when the queue is empty." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="QueueFooter" Grid.Row="2" Spacing="8" Visibility="Collapsed"><Button x:Name="QueuePlayNextButton" Content="Play next in queue" Click="NextClicked" HorizontalAlignment="Stretch" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" /><TextBlock x:Name="QueueNextDescription" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <StackPanel x:Name="RetrySettingsFooter" Grid.Row="2" Spacing="8" Visibility="Collapsed"><Button x:Name="ApplyRetryButton" Content="Apply and retry" Click="ApplyRetryClicked" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" /><Button Content="Cancel" Click="CancelRetrySettingsClicked" HorizontalAlignment="Stretch" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
