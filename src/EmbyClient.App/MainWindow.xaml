<wex:WindowEx
    x:Class="EmbyClient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wex="using:WinUIEx"
    Title="Emby for Windows">
    <wex:WindowEx.SystemBackdrop><MicaBackdrop /></wex:WindowEx.SystemBackdrop>
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DetailBackdropLayer" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed"
              Background="{ThemeResource DetailBackdropBaseBrush}" AutomationProperties.AccessibilityView="Raw">
            <Image x:Name="DetailBackdropImage" Stretch="UniformToFill" />
            <Border Background="{ThemeResource DetailBackdropVerticalMaskBrush}" />
            <Border Background="{ThemeResource DetailBackdropHorizontalMaskBrush}" />
        </Grid>
        <TitleBar x:Name="AppTitleBar" Title="Emby for Windows" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                  Background="{ThemeResource DetailTitleBarBackgroundBrush}" />
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</wex:WindowEx>
