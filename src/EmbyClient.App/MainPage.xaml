<Page
    x:Class="EmbyClient.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <FontIcon Glyph="&#xE714;" FontSize="48" HorizontalAlignment="Left" />
            <TextBlock Text="Your library. On Windows." Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Connect to your Emby server to browse your movies and shows, and pick up where you left off." TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
            <TextBlock Text="Native Windows client · Development build" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>